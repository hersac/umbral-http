!!$
 $ Incoming HTTP message built by the server per accepted socket and
 $ passed to Router.execute(), which fills route params via setParam().
 $ Outgoing calls to external APIs use the native pulse client
 $ directly: c: res = awa: pulse(url, "GET");
 $ Header pairs use static "name"/"value" keys because dictionaries
 $ are immutable in Umbral: entries accumulate in a list.
 $ Query and path params are QueryParams/PathParams instances so
 $ typed annotations validate: c: filters->QueryParams = req.query;
 $!!

equip { QueryParams, PathParams } origin 'Types.um';

out cs: Request {
    !!$
     $ Server path (example: "/users/42").
    $!!
    pr: url->Str;

    !!$
     $ HTTP verb in uppercase.
    $!!
    pr: method->Str;

    !!$
     $ Header pairs as a list of ["name" => ..., "value" => ...] entries.
    $!!
    pr: headers;

    !!$
     $ Body data, or null.
    $!!
    pr: body;

    !!$
     $ Route params as a PathParams instance.
    $!!
    pr: params;

    !!$
     $ Query values as a QueryParams instance.
    $!!
    pr: query;

    !!$
     $ Creates an incoming request message.
     $ @param->[Str] url - Server path (example: "/users/42").
     $ @param->[Str] method - HTTP verb in uppercase.
    $!!
    pu f: Request(url->Str, method->Str) {
        th.url = url;
        th.method = method;
        th.headers = {};
        th.body = null;
        th.params = n: PathParams();
        th.query = n: QueryParams();
    }

    !!$
     $ Appends a header pair. Duplicates allowed (example: Set-Cookie).
     $ @param->[Str] name - Header name.
     $ @param->[Str] value - Header value.
     $ @returns->[Request] The same Request for chaining.
    $!!
    pu f: setHeader(name->Str, value->Str)->Request {
        th.headers = th.headers + {[ "name" => name, "value" => value ]};
        r: (th);
    }

    !!$
     $ Looks up a header value by name.
     $ @param->[Str] name - Header name.
     $ @returns The value, or null when missing.
    $!!
    pu f: getHeader(name->Str) {
        fe: (v: entry <= th.headers) {
            i: (entry.name == name) {
                r: (entry.value);
            }
        }
        r: (null);
    }

    !!$
     $ Stores a route param (used by the router for ":param" segments).
     $ @param->[Str] name - Param name.
     $ @param value - Param value.
     $ @returns->[Request] The same Request for chaining.
    $!!
    pu f: setParam(name->Str, value)->Request {
        th.params.set(name, value);
        r: (th);
    }

    !!$
     $ Looks up a route param by name.
     $ @param->[Str] name - Param name.
     $ @returns The value, or null when missing.
    $!!
    pu f: getParam(name->Str) {
        r: (th.params.get(name));
    }

    !!$
     $ Stores a query value.
     $ @param->[Str] name - Query name.
     $ @param value - Query value.
     $ @returns->[Request] The same Request for chaining.
    $!!
    pu f: setQuery(name->Str, value)->Request {
        th.query.set(name, value);
        r: (th);
    }

    !!$
     $ Looks up a query value by name.
     $ @param->[Str] name - Query name.
     $ @returns The value, or null when missing.
    $!!
    pu f: getQuery(name->Str) {
        r: (th.query.get(name));
    }

    !!$
     $ Replaces the body.
     $ @param body - Body data.
     $ @returns->[Request] The same Request for chaining.
    $!!
    pu f: setBody(body)->Request {
        th.body = body;
        r: (th);
    }

    !!$
     $ Reads the body.
     $ @returns The body, or null when missing.
    $!!
    pu f: getBody() {
        r: (th.body);
    }
}
